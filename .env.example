# SteamSwap 环境变量参考
# 程序不会自动加载 .env；请通过 PowerShell、shell 或服务管理器设置。
# PowerShell 示例：$env:STEAMSWAP_MODE = 'server'

# 运行模式（server / desktop / auto）
STEAMSWAP_MODE=server

# 阅读并同意 README 免责声明后，首次非交互启动可设置为 1
# STEAMSWAP_AGREE_DISCLAIMER=1

# 服务监听地址与端口
STEAMSWAP_HOST=127.0.0.1
STEAMSWAP_PORT=28472

# 可选：代理（访问 Steam 社区时使用）
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# 可选：强制无头 / 手动登录
# STEAMSWAP_HEADLESS=1
# STEAMSWAP_MANUAL_LOGIN_ONLY=1
